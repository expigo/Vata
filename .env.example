# MQTT Configuration
# NOTE: If running on VPS, use the host's IP accessible from within Docker
# For local MQTT broker, use 'host.docker.internal' on Mac/Windows or the host's network IP on Linux
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=vata
MQTT_PASSWORD=not_real_pass
MQTT_TOPIC=#

# Server Configuration
# These are used by Docker Compose
PORT=3000
HOST=0.0.0.0
